<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aicompany.periodic</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/workspace/docs/ops/inbox/run-periodic.sh</string>
	</array>
	<key>StartInterval</key>
